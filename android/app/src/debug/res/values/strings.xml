<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork-only (noop-staging): debug builds are the testing/staging app. The package is already
  com.noop.whoop.debug (debug applicationIdSuffix), so it installs ALONGSIDE the official NOOP
  (com.noop.whoop) with its own data. This override gives it a distinct launcher name so the two
  are tellable apart on the home screen. Build-type source set wins over main/flavor, so
  assembleFullDebug shows this label. Mirrors how the demo flavor labels itself "NOOP Demo".

  LOCAL FORK CHANGE: relabelled "NOOP Staging" -> "NOOP". This install is the only NOOP on the
  device (the official APK is never installed, because history offload is destructive on the
  strap), so there is nothing to disambiguate from and the staging label is just noise.

  The value now matches src/main's app_name, so this override is redundant and the file could
  simply be deleted. It is kept because deleting an upstream file turns any future upstream edit
  to it into a modify/delete conflict, which is more annoying to resolve than a content one.
-->
<resources>
    <string name="app_name">NOOP</string>
</resources>
